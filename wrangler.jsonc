{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "licencias-recoleta",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-25",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // La interfaz y la API viven en el mismo Worker.
  // Workers Static Assets es la forma actual de publicar lo que antes era
  // Cloudflare Pages (UI) más un Worker (API). No desplegar sin aprobación.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "licencias_recoleta",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "licencias-recoleta-fotos"
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "AUTH_MODE": "local",
    "AUTO_SEED": "true",
    "PHOTO_BACKEND": "r2",
    "PBKDF2_ITERATIONS": "100000"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "AGENDA_LOCK", "class_name": "AgendaLock" },
      { "name": "CAPTURE_SESSION", "class_name": "CaptureSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgendaLock", "CaptureSession"] }
  ],
  "env": {
    "test": {
      "name": "agendamiento-licencias-recoleta-test",
      "vars": {
        "APP_ENV": "test",
        "AUTH_MODE": "local",
        "AUTO_SEED": "true",
        "PHOTO_BACKEND": "r2",
        "PBKDF2_ITERATIONS": "100000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "licencias_recoleta_test",
          "database_id": "00000000-0000-4000-8000-0000000000d1",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FOTOS",
          "bucket_name": "licencias-recoleta-fotos-test"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "AGENDA_LOCK", "class_name": "AgendaLock" },
          { "name": "CAPTURE_SESSION", "class_name": "CaptureSession" }
        ]
      }
    }
  }
}
